---
import Layout from "../layouts/Layout.astro";
import ShowcaseTabs from "../components/ShowcaseTabs.astro";
import { Content as InstallSnippet } from "../snippets/install.md";
import { Content as RustSnippet } from "../snippets/rust.md";
import { Content as TypeScriptSnippet } from "../snippets/typescript.md";
import { Content as BashSnippet } from "../snippets/bash.md";
import { Content as CppSnippet } from "../snippets/cpp.md";
import { Content as JavaSnippet } from "../snippets/java.md";
import { Content as YamlSnippet } from "../snippets/yaml.md";

const showcaseItems = [
  { id: "rust", title: "Rust", icon: "🦀", tag: "systems", color: "var(--sunshine)" },
  { id: "typescript", title: "TypeScript", icon: "📘", tag: "web", color: "var(--lavender)" },
  { id: "bash", title: "Bash", icon: "🐚", tag: "shell", color: "var(--tangerine)" },
  { id: "cpp", title: "C++", icon: "⚙️", tag: "systems", color: "var(--sky)" },
  { id: "java", title: "Java", icon: "☕", tag: "jvm", color: "var(--blossom)" },
  { id: "yaml", title: "YAML", icon: "🔧", tag: "config", color: "var(--mint)" },
];
---

<Layout title="astro-arborium">
  <div class="hero hero--split">
    <div class="hero__text">
      <div class="hero__features">
        <span class="pill pill-lavender">🌳 tree-sitter powered</span>
        <span class="pill pill-blossom">⚡ zero runtime JS</span>
        <span class="pill pill-mint">🚀 Astro native</span>
      </div>
      <h1>
        Syntax highlighting<br />with a little <span class="word-arborium">Arborium</span>
      </h1>
      <p class="hero-tagline">
        A lightweight Astro integration that hands your fenced code blocks to
        <code>tree-sitter</code> for fast, precise, language-aware highlighting.
      </p>
      <div class="hero__code">
        <InstallSnippet />
      </div>
      <div class="hero-actions">
        <a class="btn btn-primary" href="https://github.com/InfiniteUnion/astro-arborium">Github ↗</a>
        <a class="btn btn-secondary" href="https://arborium.bearcove.eu/" target="_blank" rel="noopener noreferrer">Visit Arborium ↗</a>
      </div>
    </div>
    <div class="hero__visual">
      <img class="hero-logo" src="/logo.webp" alt="Astro Arborium logo" width="600" height="338" />
    </div>
  </div>

  <div class="section" id="showcase">
    <div class="section-header">
      <span class="icon" aria-hidden="true">🎨</span>
      <h2>Highlight showcase</h2>
    </div>
    <p class="section-desc">
      Tree-sitter understands the structure of each language, so keywords, types,
      strings, comments, and macros are highlighted with real semantic accuracy.
      Pick a language to see a sample.
    </p>

    <ShowcaseTabs items={showcaseItems}>
      <Fragment slot="rust">
        <RustSnippet />
      </Fragment>
      <Fragment slot="typescript">
        <TypeScriptSnippet />
      </Fragment>
      <Fragment slot="bash">
        <BashSnippet />
      </Fragment>
      <Fragment slot="cpp">
        <CppSnippet />
      </Fragment>
      <Fragment slot="java">
        <JavaSnippet />
      </Fragment>
      <Fragment slot="yaml">
        <YamlSnippet />
      </Fragment>
    </ShowcaseTabs>
  </div>

  <div class="cta-card" id="install">
    <h2>Ready to plant some color?</h2>
    <p>Add <code>astro-arborium</code> to your Astro project, disable the default syntax highlighter, and let Arborium handle the rest.</p>
    <p><a class="btn" href="https://github.com/InfiniteUnion/astro-arborium" target="_blank" rel="noopener noreferrer">Read the docs ↗</a></p>
  </div>

  <footer class="site-footer">
    <p>Made with 💜 for Astro · <a href="https://github.com/InfiniteUnion/astro-arborium" target="_blank" rel="noopener noreferrer">InfiniteUnion/astro-arborium</a></p>
  </footer>
</Layout>
