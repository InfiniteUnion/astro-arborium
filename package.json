{
  "name": "astro-arborium-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @infiniteunion/astro-arborium build",
    "typecheck": "pnpm --filter @infiniteunion/astro-arborium typecheck",
    "lint": "oxlint",
    "sync-meta": "cp packages/astro-arborium/README.md packages/astro-arborium/LICENSE* .",
    "release": "pnpm --filter @infiniteunion/astro-arborium exec semantic-release"
  },
  "packageManager": "pnpm@11.22.0",
  "devDependencies": {
    "@semantic-release/git": "^11.0.1",
    "oxlint": "^1.78.0",
    "semantic-release": "^25.0.9",
    "semantic-release-monorepo": "^8.0.2"
  }
}
