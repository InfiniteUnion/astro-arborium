{
  "name": "astro-arborium-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "website"
  ],
  "scripts": {
    "build": "bun run --filter astro-arborium build",
    "typecheck": "bun run --filter astro-arborium typecheck",
    "sync-meta": "cp packages/astro-arborium/README.md packages/astro-arborium/LICENSE* ."
  },
  "packageManager": "bun@1.3.14"
}
