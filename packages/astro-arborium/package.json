{
  "name": "astro-arborium",
  "version": "0.0.1",
  "description": "Astro integration for Arborium syntax highlighting",
  "license": "Apache-2.0 OR MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./rehype": {
      "types": "./dist/rehype.d.ts",
      "default": "./dist/rehype.js"
    },
    "./highlight": {
      "types": "./dist/highlight.d.ts",
      "default": "./dist/highlight.js"
    },
    "./labels": {
      "types": "./dist/labels.d.ts",
      "default": "./dist/labels.js"
    },
    "./components": "./dist/components/Code.astro",
    "./style.css": "./dist/style.css",
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "logo.png",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && cp src/style.css dist/style.css && cp -r src/components dist/components",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build && cp README.md LICENSE LICENSE-APACHE LICENSE-MIT ../../"
  },
